PORT=3000

LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret
# 取得方式：LINE Developers → 選擇你的 LINE Login 頻道（與 LIFF 同一個 provider） → Basic settings → Channel ID
# 用於後端驗證 LIFF 傳來的 ID Token (server-side verify)
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id

SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
# 取得方式：Supabase 專案 Dashboard → Project Settings → API → Project API keys → service_role (copy secret)
# 用於後端建立 signed upload/read URLs、寫入 photos 與 status logs 等需要高權限的操作
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

LIFF_ID=your_liff_id
LIFF_FORM_URL=https://your-ngrok-url/liff.html
CANDIDATE_NAME=ＯＯ

# 許願池後台管理員白名單（逗號分隔多個 LINE user id，即 LINE verify API 回傳的 sub）
# 取得方式：管理員先從 LIFF 登入後，於後端 log 或 Supabase user_feedback.line_user_id 查得自己的 sub
# 列在此名單內的 LINE 帳號可使用 /api/admin/* 與前端「管理」入口
ADMIN_LINE_USER_IDS=
# 管理端電腦版 LIFF（同一個 LINE Login 頻道下的第二個 LIFF app）
# 真實 ID 寫在本機 .env 與 Vercel，不要提交進 Git
ADMIN_LIFF_ID=

# 報平安排程通知（Vercel Cron 打 /api/cron/safety-reminders 的 Bearer token）
# 產生方式：openssl rand -hex 32（或任意亂數字串）
# 設定後 Vercel Cron 會自動帶 Authorization: Bearer <CRON_SECRET>；本機手動測試需自行加同值 header
# 未設定時端點回 503（排程停用），設錯回 401
CRON_SECRET=

# 管理員通知第一期：即時 Email（Resend）
# RESEND_API_KEY：未設定時跳過寄信（僅 log，不報錯；後台紅點功能不受影響）
# 取得方式：resend.com 註冊 → API Keys（免費方案即可）
RESEND_API_KEY=
# 收件人（逗號分隔多個 email；三類事件當下逐封寄出）
ADMIN_NOTIFY_EMAILS=
# 寄件人（自有網域，例：幸福正砂 <notify@mail.zhengshavil.com>）；
# 未設定時 fallback onboarding@resend.dev（只能寄到 Resend 註冊信箱）
ADMIN_NOTIFY_FROM=
# Reply-To（選填，真實信箱如 Gmail；有設才帶，沒設不帶）
ADMIN_NOTIFY_REPLY_TO=
