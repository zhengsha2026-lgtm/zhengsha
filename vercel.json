{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/cron/safety-reminders/resident", "schedule": "0 12 * * *" },
    { "path": "/api/cron/safety-reminders/admin", "schedule": "0 1 * * *" }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/liff.html"
    },
    {
      "source": "/webhook",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ]
}
